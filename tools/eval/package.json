{
  "name": "@esim-detector/tools-eval",
  "version": "0.1.0",
  "private": true,
  "description": "Стенд оценки качества автоопределения и обработки ввода на эталонных выборках (docs/08-testing-and-quality.md, раздел 8.6)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "eval": "ts-node -T src/run-eval.ts",
    "eval:detection": "ts-node -T src/run-detection-eval.ts",
    "eval:matching": "ts-node -T src/run-matching-eval.ts"
  },
  "dependencies": {
    "@esim-detector/text-normalizer": "workspace:*",
    "@esim-detector/fuzzy-matcher": "workspace:*"
  },
  "devDependencies": {
    "ts-node": "10.9.2"
  }
}

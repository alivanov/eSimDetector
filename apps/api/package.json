{
  "name": "@esim-detector/api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API сервиса определения устройства и статуса поддержки eSIM (NestJS)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest"
  },
  "dependencies": {
    "@esim-detector/contracts": "workspace:*",
    "@esim-detector/esim-rules": "workspace:*",
    "@esim-detector/fuzzy-matcher": "workspace:*",
    "@esim-detector/text-normalizer": "workspace:*",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "mongoose": "9.9.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@esim-detector/test-utils": "workspace:*",
    "@nestjs/testing": "11.2.1",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "ts-node-dev": "2.0.0"
  }
}

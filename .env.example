# Полный перечень переменных окружения — docs/07-integration.md, раздел 7.8.
# Копировать в .env не обязательно: значения по умолчанию рабочие
# (docs/07-integration.md, раздел 7.6). Тесты эти переменные не используют:
# они поднимают собственный изолированный экземпляр MongoDB (docs/08-testing-and-quality.md, 8.5).

# Порт, на котором слушает API
PORT=3000

# Строка подключения к MongoDB
MONGODB_URI=mongodb://mongo:27017/esim

# Режим работы: development | test | production
NODE_ENV=production

# Разрешённые источники CORS (список через запятую) либо "*"
CORS_ORIGINS=*

# Ключи API для server-to-server интеграции через X-Api-Key (через запятую).
# При пустом значении проверка ключа отключена.
API_KEYS=

# Ограничение частоты запросов на источник, запросов в минуту
RATE_LIMIT_RPM=120

# Порог уверенности для выдачи однозначного ответа (0..1)
CONFIDENCE_ANSWER_THRESHOLD=0.8

# Минимальный разрыв между кандидатами при поиске (0..1)
CONFIDENCE_GAP_THRESHOLD=0.08

# Разрешать ли однозначный ответ по непроверенным записям справочника
ALLOW_UNVERIFIED_CATALOG_ANSWERS=false

# Резервная нормализация ввода генеративной моделью (ADR-004, по умолчанию выключена)
ENABLE_LLM_FALLBACK=false

# Токен доступа к разделу модерации /admin. При пустом значении раздел закрыт.
ADMIN_TOKEN=

# Уровень журналирования: fatal | error | warn | info | debug | verbose
LOG_LEVEL=info

# Срок хранения журнала резолюций, дней
RESOLUTION_LOG_TTL_DAYS=30
